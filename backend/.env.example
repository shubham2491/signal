# SIGNAL backend environment

# Default LLM provider: Gemini (free tier on gemini-1.5-flash is generous).
# Swap LLM_PROVIDER to openai if you'd rather use gpt-4o.
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# Used only when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Web intelligence (optional — pipeline still runs without it)
TAVILY_API_KEY=tvly-...

# Public base URL the mobile client can reach (used to mint PDF download
# links). For local dev with Expo Go, use your LAN IP, eg http://192.168.1.5:8000
# On Render this is auto-detected via RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=http://localhost:8000

# Reports age out after this many hours (startup sweep)
REPORT_TTL_HOURS=24

# When 1, the pipeline returns deterministic mock output if API keys are
# missing — useful for offline demos and previews.
ALLOW_MOCK_FALLBACK=1
