# SIGNAL backend environment

# OpenAI is the default LLM provider (gpt-4o for vision).
# Swap LLM_PROVIDER to anthropic|gemini once those adapters are wired.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Web intelligence
TAVILY_API_KEY=tvly-...

# Public base URL the mobile client can reach (used to mint PDF download
# links). For local dev with Expo Go, use your LAN IP, eg http://192.168.1.5:8000
PUBLIC_BASE_URL=http://localhost:8000

# Reports age out after this many hours (cron / startup sweep)
REPORT_TTL_HOURS=24

# Set to 1 to fall back to a deterministic mock pipeline when API keys
# are missing — useful for offline demos.
ALLOW_MOCK_FALLBACK=1
